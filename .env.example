# Copy this file to .env.local (git-ignored) and fill in the values from the
# Supabase dashboard: Project Settings → API Keys / Data API.
#
# Only these two browser-safe values belong here. Never add the secret key,
# the service_role key, the database password or a Supabase access token to
# any .env file read by Next.js (architecture.md §11).
#
# Automated tests never read this file; they use the local test stack.

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe in the browser: access is
# controlled by RLS and database privileges.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
